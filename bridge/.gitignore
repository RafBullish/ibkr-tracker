# Environnement virtuel Python + caches — ne pas commiter.
.venv/
venv/
__pycache__/
*.pyc

# Snapshot runtime — écrit par ibkr_poller.py, lu par serve.py.
# Données de session, jamais commitées.
snapshot.json
snapshot.json.tmp

# Journaux runtime bridge v2 — mémoire de vol + outbox, données de session.
v2/journal.ndjson
v2/outbox.ndjson
# Secrets bridge v2 — clé service_role, jamais commitée.
.env
v2/.env
